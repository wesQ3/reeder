# Local override values (not committed): copy to config.override.toml

[tts.remote]
enabled = true
url = "http://your-remote-worker-host:8100"
timeout = 300
# Wake-on-LAN: EXPERIMENTAL — enable only if magic packets work on your network.
[tts.remote.wake]
enabled = false
mac = "aa:bb:cc:dd:ee:ff"
broadcast = "255.255.255.255"
port = 9
retries = 5
retry_interval = 1.0
wait = 60
poll_interval = 3

[feed]
# Keep your local deployment URL out of tracked config.toml.
base_url = "https://your-hostname.example"
