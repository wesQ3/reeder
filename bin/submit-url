#!/usr/bin/env python3
"""Submit a URL job to Reeder (push inbox or pull API, based on config)."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _submit_lib import fail, submit


def main() -> None:
    if len(sys.argv) < 2 or not sys.argv[1]:
        fail("Usage: submit-url <URL> [title]")
    request = {"type": "url", "url": sys.argv[1]}
    if len(sys.argv) > 2 and sys.argv[2]:
        request["title"] = sys.argv[2]
    try:
        result = submit(request)
    except RuntimeError as exc:
        fail(str(exc))
    detail = result.get("detail_url")
    print(f"Submitted: {result['id']}" + (f" ({detail})" if detail else ""))


if __name__ == "__main__":
    main()
