#!/usr/bin/env python3
# ruff: noqa: E402,F401
"""Reeder RSS Feed Generator

Scans the done/ directory for completed jobs and generates an RSS 2.0 podcast feed.
"""

# Auto-bootstrap: re-exec with uv if not in proper venv
def _bootstrap():
    import sys
    if not getattr(sys, '_reeder_bootstrapped', False):
        try:
            from xml.etree.ElementTree import Element  # stdlib, always works
        except ImportError:
            pass
        sys.modules['__main__']._reeder_bootstrapped = True
_bootstrap()

import os
import sys
from pathlib import Path

# Allow importing the local reeder package from /usr/lib/reeder.
PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from reeder.config import load_config
from reeder.feed import update_feed


def main():
    """Main entry point."""
    config_path = os.environ.get("REEDER_CONFIG")
    config = load_config(Path(config_path) if config_path else None)
    update_feed(config)


if __name__ == "__main__":
    main()
