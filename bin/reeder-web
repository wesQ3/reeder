#!/usr/bin/env python3
# ruff: noqa: E402
"""Reeder Web - FastAPI UI and pull-worker API.

The original form, bookmarklet, /add, /status, audio, and feed routes remain
compatible. Worker-facing routes live under /api/v1 and require a bearer token.
"""

import argparse
import os
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the Reeder web service")
    parser.add_argument("--config", help="Path to config.toml")
    parser.add_argument(
        "--host", default=os.environ.get("REEDER_WEB_HOST", "127.0.0.1")
    )
    parser.add_argument(
        "--port", type=int, default=int(os.environ.get("REEDER_WEB_PORT", "8081"))
    )
    parser.add_argument("--reload", action="store_true", help="Development auto-reload")
    args = parser.parse_args()

    if args.config:
        os.environ["REEDER_CONFIG"] = str(Path(args.config).resolve())

    try:
        import uvicorn
    except ImportError:
        sys.stderr.write(
            "uvicorn is not installed. Run `uv sync` in the Reeder install directory.\n"
        )
        raise SystemExit(1)

    from reeder.web import create_app

    app = create_app(args.config)
    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload,
        log_level=os.environ.get("REEDER_LOG_LEVEL", "info"),
    )


if __name__ == "__main__":
    main()
