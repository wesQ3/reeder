#!/usr/bin/env python3
"""Submit text directly to Reeder (push inbox or pull API)."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _submit_lib import fail, submit


def main() -> None:
    if len(sys.argv) < 2:
        fail("Usage: submit-text <title> <text>\n       submit-text <title> -\n       echo 'text' | submit-text <title>")
    title = sys.argv[1] or "Untitled"
    if len(sys.argv) > 2 and sys.argv[2] != "-":
        text = " ".join(sys.argv[2:])
    else:
        text = sys.stdin.read()
    if not text.strip():
        fail("Error: no text provided")
    try:
        result = submit({"type": "text", "title": title, "text": text})
    except RuntimeError as exc:
        fail(str(exc))
    detail = result.get("detail_url")
    print(f"Submitted: {result['id']}" + (f" ({detail})" if detail else ""))


if __name__ == "__main__":
    main()
