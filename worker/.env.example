# Host-side paths, used by docker-compose for volume substitution ONLY.
# These values must never be loaded into the container environment
# (do not add env_file: .env to the compose service).

# Directory on the host containing voice files (default.wav, default.txt, *.json aliases, ...)
VOICES_DIR=/var/lib/reeder/voices

# Directory on the host where GGUF models are stored.
# Mounted writable at /app/models inside the container, which is audio.cpp's
# default models root: downloads from the WebUI / model manager land here.
MODELS_DIR=/var/lib/reeder/models

# Default active TTS model (id configured in server.json)
# Options: qwen3-tts, qwen3-tts-0.6b, pocket-tts, kokoro-82m
ACTIVE_TTS_MODEL=qwen3-tts

# Device backend for audio.cpp (cuda or cpu)
AUDIOCPP_BACKEND=cuda

# --- Chunking & runaway-generation detection (gateway tuning) ---
# Token estimate fallback for single-text requests without measured token counts
# (chunking itself happens on the job processor with the real Qwen tokenizer)
#CHARS_PER_TOKEN=4.0
# z-score threshold marking a chunk as a runaway generation
#OUTLIER_Z_LIMIT=3.0
# Generation attempts per chunk
#MAX_ATTEMPTS_PER_CHUNK=3
# HTTP timeout (seconds) per chunk request to audio.cpp
#CHUNK_HTTP_TIMEOUT=300
# Comma-separated samples-per-token history seed for outlier detection
#SAMPLES_PER_TOKEN_SEED=5110,4793,5234,5889,5130,5941,5877,5138,5607,6370,6260,6381,5894,5538,6027,5280
