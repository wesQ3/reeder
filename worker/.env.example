# Path to voice files on the host
VOICES_DIR=/path/to/voices

# Qwen3-TTS model (larger models need more VRAM)
# Options: Qwen/Qwen3-TTS-12Hz-0.6B-Base (default, ~2GB VRAM)
#          Qwen/Qwen3-TTS-12Hz-1.5B (needs ~6GB VRAM)
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# Device (cuda or cpu)
TTS_DEVICE=cuda
